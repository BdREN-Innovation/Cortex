# Copy to engine/.env and fill in. Never commit .env.
#
# configs/ is committed and reviewed; .env is not. A key in a config file is a
# key in the git history forever.

# ── Embeddings (Team B) ───────────────────────────────────────────────────
# Needed to build an index. Embeddings come from a hosted API — nothing runs
# a model locally. Install whichever client you choose, e.g. `uv add openai`.
OPENAI_API_KEY=

# ── Vector store (Team B) ─────────────────────────────────────────────────
# Qdrant Cloud: create a free cluster and copy its URL and key here.
# Only needed once you switch `backend: qdrant`; the local numpy backend needs
# nothing.
QDRANT_URL=
QDRANT_API_KEY=

# ── Generation (Team B) ───────────────────────────────────────────────────
# For `engine ask` with --provider openai or anthropic. The default
# `extractive` provider needs no key and just returns the best matching
# passage — enough to check that retrieval works before spending on generation.
#
# ANTHROPIC_API_KEY is generation only. Anthropic has no embeddings endpoint.
ANTHROPIC_API_KEY=

# ── Optional crawler overrides (Team A; the config file wins over these) ──
# ENGINE_USER_AGENT=CortexEngine/0.1 (+https://github.com/BdREN-Innovation/Cortex)
# ENGINE_CRAWL_DELAY_SECONDS=1.0

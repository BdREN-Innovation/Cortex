# Copy to engine/.env. Mirrors the provider convention already used by the
# Cortex backend, so keys are interchangeable between the two.

# Generation providers (engine ask --provider openai|anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings currently come from OpenAI only; the offline default needs no key.
# Anthropic does not expose an embeddings endpoint.

# Optional crawler overrides (config file wins over these)
# ENGINE_USER_AGENT=CortexEngine/0.1 (+https://github.com/BdREN-Innovation/Cortex)
# ENGINE_CRAWL_DELAY_SECONDS=1.0

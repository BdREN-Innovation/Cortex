# Copy to engine/.env and fill in. Never commit .env.
#
# configs/ is committed and reviewed; .env is not. A key in a config file is a
# key in the git history forever.
#
# Add the variables your own choices imply and delete the ones they do not.
# This file is a reminder of what needs a secret, not a list of what to use.


# ── Vector store (Team B) ─────────────────────────────────────────────────
# Qdrant Cloud is the project's target. Create a free cluster and copy its URL
# and key here. Not needed until you actually point the indexer at it.
QDRANT_URL=
QDRANT_API_KEY=


# ── Embeddings (Team B) ───────────────────────────────────────────────────
# Needed to build an index. Embeddings come from a hosted API — nothing runs a
# model locally. Which provider is your choice, so add the variable that
# provider expects, e.g.:
#
# <PROVIDER>_API_KEY=


# ── Generation (Team B) ───────────────────────────────────────────────────
# Only needed once `engine ask` actually calls a model. A baseline that returns
# the best retrieved passage verbatim needs no key at all, and is worth having
# first — it tells you whether retrieval works before you start paying for
# generation.
#
# <PROVIDER>_API_KEY=


# ── Optional crawler overrides (Team A; the config file wins over these) ──
# ENGINE_USER_AGENT=CortexEngine/0.1 (+https://github.com/BdREN-Innovation/Cortex)
# ENGINE_CRAWL_DELAY_SECONDS=1.0

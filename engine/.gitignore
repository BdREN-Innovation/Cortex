# Runtime artifacts — the handoff surface between teams. Never committed.
/data/*
!/data/.gitkeep

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage

# Secrets
.env
.env.*
!.env.example

corpus/*/_files/
corpus/*/*.jsonl
extract_log.txt

# Generated scratch corpus
scratch/corpus/

# Generated embedding files
scratch/tests/embeddings/

# Generated evaluation samples
scratch/tests/eval/sample_chunks.jsonl
